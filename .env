# Ollama native server configuration.
# Sourced by scripts/up.sh before starting `ollama serve`.
# These are standard Ollama environment variables.

# Bind address. 0.0.0.0 allows Docker containers (Open WebUI) to reach
# Ollama via host.docker.internal. macOS firewall still blocks LAN access.
OLLAMA_HOST=0.0.0.0:11434

# Performance: flash attention + quantized KV cache (recommended by brew for Apple Silicon)
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Max models kept loaded in GPU memory simultaneously.
# With 128GB unified memory and Metal, 2 is comfortable for any pair
# including the 70B. Increase to 3 if you skip the 70B model often.
OLLAMA_MAX_LOADED_MODELS=2

# Max concurrent requests per loaded model
OLLAMA_NUM_PARALLEL=4

# How long a model stays loaded after its last request
OLLAMA_KEEP_ALIVE=10m

# Uncomment to store models somewhere other than ~/.ollama
# OLLAMA_MODELS=/Volumes/fast-ssd/ollama/models
